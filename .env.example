# Anisekai environment variables
# Real values live in Vercel Project Settings -> Environment Variables. Never commit secrets.

# --- Database (Postgres / Neon) ---
# Pooled connection used by the app at runtime (via @prisma/adapter-pg).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (unpooled) connection used by prisma migrate.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (self-hosted JWT via jose) ---
# Long random string used to sign session tokens.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Media (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- AI providers (configurable, never hardcoded) ---
# Provider defaults are configured in the CMS; keys are read from env by key name.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""
OPENROUTER_API_KEY=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Super Admin (used by prisma/seed.ts) ---
# Login ID for the CMS. Defaults to admin@anisekai.com / A99nime if unset.
# Set a strong ADMIN_PASSWORD in Vercel for production.
ADMIN_EMAIL="admin@anisekai.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="A99nime"
